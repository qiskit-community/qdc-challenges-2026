# ──────────────────────────────────────────────────────────────────────────────
# .env.example — credentials for the QDC 2026 Proteasome Ligand Challenge
#
# Copy this file to .env in the same directory and fill in your values:
#
#   cp .env.example .env
#
# .env is gitignored — it will never be committed.
# ──────────────────────────────────────────────────────────────────────────────

# ── Qiskit Serverless authentication ─────────────────────────────────────────
# Both variables are required by QiskitServerless(token=..., instance=...).
#
# TOKEN    : IBM Quantum API key — quantum.ibm.com → Account → API key
# INSTANCE : IBM Cloud CRN for your Quantum service instance
#   Format  : crn:v1:bluemix:public:quantum-computing:<region>::a/<acct-id>:<service-id>::
#   Location: cloud.ibm.com → Resource list → <your Quantum service> → CRN field
IBM_QUANTUM_TOKEN=<your-ibm-quantum-api-key>
IBM_QUANTUM_INSTANCE=crn:v1:bluemix:public:quantum-computing:<region>::a/<account-id>:<service-id>::

# ── QPU backend ──────────────────────────────────────────────────────────────
# IBM backend used for QPU sampling (Stage E 3b, live sampling only) and recorded in the
# promoted configuration. Read at call time by proteasome_challenge.resolve_qpu_backend().
# Letters, digits, '_', '-' and '.' only. If unset, the code falls back to ibm_kingston.
# Changing it also changes the QRMI variable prefix below (<backend_name>_QRMI_*).
IBM_QUANTUM_BACKEND=ibm_kingston

# ── QRMI — direct QPU access ─────────────────────────────────────────────────
# The prefix <backend_name>_ must be lowercase and match IBM_QUANTUM_BACKEND above.
# Your IAM API key and CRN are the same values used above.
ibm_kingston_QRMI_IBM_QCS_IAM_APIKEY=<your-iam-api-key>
ibm_kingston_QRMI_IBM_QCS_SERVICE_CRN=<your-service-crn>

# ── Optional overrides ────────────────────────────────────────────────────────
# Set automatically by the Serverless / QRMI runtime; only needed for local testing.
#
# QRMI_JOB_QPU_RESOURCES=ibm_kingston     # keep equal to IBM_QUANTUM_BACKEND
# QRMI_JOB_QPU_TYPES=ibm-quantum-compute-service
